set_global_assignment -name SDC_FILE Marty.sdc
# rtl/mem/sdram.sdc derives the SDRAM_CLK pin clock from the PLL output, so it
# must come after the core SDC that runs derive_pll_clocks.
set_global_assignment -name SDC_FILE rtl/mem/sdram.sdc
set_global_assignment -name SYSTEMVERILOG_FILE Marty.sv

# CPU: z386 (rtl/cpu/z386/UPSTREAM.md)
